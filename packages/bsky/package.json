{
  "name": "@atproto/bsky",
  "version": "0.0.275",
  "license": "MIT",
  "description": "Reference implementation of app.bsky App View (Bluesky API)",
  "keywords": [
    "atproto",
    "bluesky"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/bsky"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "workspace:^",
    "@atproto-labs/opentelemetry-node": "workspace:^",
    "@atproto-labs/xrpc-utils": "workspace:^",
    "@atproto/api": "workspace:^",
    "@atproto/common": "workspace:^",
    "@atproto/crypto": "workspace:^",
    "@atproto/did": "workspace:^",
    "@atproto/identity": "workspace:^",
    "@atproto/lex": "workspace:^",
    "@atproto/repo": "workspace:^",
    "@atproto/sync": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@atproto/xrpc-server": "workspace:^",
    "@bufbuild/protobuf": "^1.5.0",
    "@connectrpc/connect": "^1.1.4",
    "@connectrpc/connect-express": "^1.1.4",
    "@connectrpc/connect-node": "^1.1.4",
    "@did-plc/lib": "^0.0.1",
    "@noble/curves": "^1.7.0",
    "@growthbook/growthbook": "^1.6.2",
    "@hapi/address": "^5.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@types/http-errors": "^2.0.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "disposable-email-domains-js": "^1.5.0",
    "etcd3": "^1.1.2",
    "express": "^4.17.2",
    "http-errors": "^2.0.0",
    "http-terminator": "^3.2.0",
    "ioredis": "^5.3.2",
    "jose": "^5.0.1",
    "kysely": "^0.29.2",
    "leo-profanity": "^1.8.0",
    "murmurhash": "^2.0.1",
    "p-queue": "^8.0.0",
    "pg": "^8.10.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.33.5",
    "structured-headers": "^1.0.1",
    "uint8arrays": "^5.0.0",
    "undici": "^8.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@atproto/pds": "workspace:^",
    "@bufbuild/buf": "^1.28.1",
    "@bufbuild/protoc-gen-es": "^1.5.0",
    "@connectrpc/protoc-gen-connect-es": "^1.1.4",
    "@did-plc/server": "^0.0.1",
    "@types/cors": "^2.8.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.13",
    "@types/express-serve-static-core": "^4.17.36",
    "@types/pg": "^8.15.5",
    "@types/qs": "^6.9.7",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "codegen:buf": "buf generate ../bsync/proto && buf generate ./proto",
    "codegen:lex": "lex build --clear --indexFile --lexicons ../../lexicons",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "verify:import": "node --input-type=module -e \"import '@atproto/bsky'\"",
    "start": "node --enable-source-maps dist/bin.js",
    "test": "../dev-infra/with-test-redis-and-db.sh vitest run",
    "test:log": "tail -50 test.log | pino-pretty",
    "test:updateSnapshot": "../dev-infra/with-test-redis-and-db.sh vitest run --update",
    "migration:create": "node ./bin/migration-create.ts",
    "buf:gen": ">&2 echo 'DEPRECATED: run `pnpm run codegen:buf` instead ' && pnpm run codegen:buf"
  }
}
