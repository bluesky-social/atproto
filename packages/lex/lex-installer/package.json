{
  "name": "@atproto/lex-installer",
  "version": "0.1.23",
  "license": "MIT",
  "description": "Lexicon document packet manager for AT Lexicons",
  "keywords": [
    "atproto",
    "lexicon",
    "install",
    "lex"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/lex/lex-installer"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "bin": {
    "lex-installer": "./bin/lex-installer"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/did": "workspace:^",
    "@atproto/lex-builder": "workspace:^",
    "@atproto/lex-client": "workspace:^",
    "@atproto/lex-cbor": "workspace:^",
    "@atproto/lex-data": "workspace:^",
    "@atproto/lex-document": "workspace:^",
    "@atproto/lex-resolver": "workspace:^",
    "@atproto/lex-schema": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@atproto-labs/did-resolver": "workspace:^",
    "@atproto-labs/handle-resolver": "workspace:^",
    "@atproto-labs/handle-resolver-node": "workspace:^",
    "tslib": "^2.8.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  }
}
