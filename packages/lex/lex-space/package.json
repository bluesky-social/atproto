{
  "name": "@atproto/lex-space",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Permissioned spaces client for AT Lexicons",
  "keywords": [
    "atproto",
    "lexicon",
    "space",
    "permissioned"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/lex/lex-space"
  },
  "files": [
    "./dist",
    "./CHANGELOG.md"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "workspace:^",
    "@atproto-labs/simple-store": "workspace:^",
    "@atproto-labs/simple-store-memory": "workspace:^",
    "@atproto/crypto": "workspace:^",
    "@atproto/did": "workspace:^",
    "@atproto/lex-cbor": "workspace:^",
    "@atproto/lex-client": "workspace:^",
    "@atproto/lex-data": "workspace:^",
    "@atproto/lex-schema": "workspace:^",
    "@atproto/space": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@atproto/dev-env": "workspace:^",
    "@atproto/jwk": "workspace:^",
    "@atproto/jwk-jose": "workspace:^",
    "@atproto/oauth-client": "workspace:^",
    "@atproto/lex-builder": "workspace:^",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "codegen:lex": "node ./scripts/lex-build.js",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  }
}
