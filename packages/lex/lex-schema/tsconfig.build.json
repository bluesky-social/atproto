{
  "extends": [
    "../../../tsconfig/isomorphic.tsconfig.json",
    "../../../tsconfig/isolated.tsconfig.json",
  ],
  "include": ["./src"],
  "exclude": ["**/*.test.ts"],
  "references": [
    { "path": "../../syntax/tsconfig.build.json" },
    { "path": "../lex-data/tsconfig.build.json" },
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // For some reason, not having this set to true causes the build to fail in
    // consumer projects that don't have "isolatedDeclarations" set to true.
    "erasableSyntaxOnly": true,
  },
}
