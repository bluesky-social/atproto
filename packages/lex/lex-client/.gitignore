# @atproto/lex
/src/lexicons

# @NOTE lexicons are installed from the network, and kept as copy here to avoid
# network dependency during ci build. com.atproto.* and tools.ozone.* lexicons
# are symlinked from the repo-wide canonical lexicons (see "resolvers" in
# lexicons.json) and can be ignored from Git.
/lexicons/com/atproto
/lexicons/tools/ozone

# legacy (old compiled lexicons schemas location)
# can safely be removed but will cause a these files to appear as untracked in git
# for any user that has previously compiled lexicons
/tests/lexicons
