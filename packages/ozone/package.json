{
  "name": "@atproto/ozone",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Backend service for moderating the Bluesky network.",
  "keywords": [
    "atproto",
    "bluesky"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/ozone"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracer": {
      "types": "./dist/tracer.d.ts",
      "default": "./dist/tracer.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "workspace:^",
    "@atproto/common": "workspace:^",
    "@atproto/crypto": "workspace:^",
    "@atproto/identity": "workspace:^",
    "@atproto/lex": "workspace:^",
    "@atproto/lex-password-session": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@atproto/ws-client": "workspace:^",
    "@atproto/xrpc-server": "workspace:^",
    "@did-plc/lib": "^0.0.4",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.17.2",
    "http-terminator": "^3.2.0",
    "import-in-the-middle": "^3.4.0",
    "kysely": "^0.29.5",
    "lande": "^1.0.10",
    "multiformats": "^13.0.0",
    "p-queue": "^8.0.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "structured-headers": "^1.0.1",
    "uint8arrays": "^5.0.0",
    "undici": "^8.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@atproto/api": "workspace:^",
    "@atproto/lexicon": "workspace:^",
    "@atproto/pds": "workspace:^",
    "@did-plc/server": "^0.0.1",
    "@jest/globals": "^30.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/express-serve-static-core": "^4.17.36",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.1"
  },
  "scripts": {
    "codegen:lex": "lex build --clear --indexFile --lexicons ../../lexicons",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "start": "node --enable-source-maps dist/bin.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules ../dev-infra/with-test-redis-and-db.sh jest",
    "test:log": "tail -50 test.log | pino-pretty",
    "test:updateSnapshot": "NODE_OPTIONS=--experimental-vm-modules ../dev-infra/with-test-redis-and-db.sh jest --updateSnapshot",
    "migration:create": "node ./bin/migration-create.ts"
  }
}
