{
  "name": "@atproto/lexicon-resolver",
  "version": "0.4.30",
  "license": "MIT",
  "description": "ATProto Lexicon resolution",
  "keywords": [
    "atproto",
    "lexicon"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/lexicon-resolver"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "workspace:^",
    "@atproto/identity": "workspace:^",
    "@atproto/lex-client": "workspace:^",
    "@atproto/lex-data": "workspace:^",
    "@atproto/lex-document": "workspace:^",
    "@atproto/lex-schema": "workspace:^",
    "@atproto/repo": "workspace:^",
    "@atproto/syntax": "workspace:^"
  },
  "devDependencies": {
    "@atproto/lex": "workspace:^",
    "@atproto/lex-cbor": "workspace:^",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "lex:build": "lex build --clear --indexFile --lib @atproto/lex-schema",
    "lex:install": "lex install",
    "postlex:install": "pnpm run lex:build",
    "lex:update": "lex update",
    "postlex:update": "pnpm run lex:build",
    "codegen:lex": "pnpm run lex:install --ci"
  }
}
