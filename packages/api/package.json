{
  "name": "@atproto/api",
  "version": "0.32.9",
  "license": "MIT",
  "description": "Client library for atproto and Bluesky",
  "keywords": [
    "atproto",
    "bluesky",
    "api"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/api"
  },
  "files": [
    "./dist",
    "./OAUTH.md",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/common-web": "workspace:^",
    "@atproto/lexicon": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@atproto/xrpc": "workspace:^",
    "await-lock": "^3.0.0",
    "multiformats": "^13.0.0",
    "tlds": "^1.234.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@atproto/lex-cli": "workspace:^",
    "@atproto/lex-installer": "workspace:^",
    "prettier": "^3.9.6",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "lex:gen": "lex gen-api --yes ./src/client ./lexicons/com/atproto/*/* ./lexicons/app/bsky/*/* ./lexicons/chat/bsky/*/* ./lexicons/tools/ozone/*/* ./lexicons/com/germnetwork/*",
    "lex:install": "lex-installer install",
    "postlex:install": "pnpm run lex:gen",
    "lex:update": "lex-installer update",
    "postlex:update": "pnpm run lex:gen",
    "codegen:lex": "pnpm run lex:install --ci",
    "codegen:code": "node ./scripts/generate-code.js",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  }
}
