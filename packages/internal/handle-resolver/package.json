{
  "name": "@atproto-labs/handle-resolver",
  "version": "0.4.9",
  "license": "MIT",
  "description": "Isomorphic ATProto handle to DID resolver",
  "keywords": [
    "atproto",
    "oauth",
    "handle",
    "identity",
    "browser",
    "node",
    "isomorphic"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/internal/handle-resolver"
  },
  "files": [
    "./dist",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/lex-client": "workspace:^",
    "@atproto/lex-schema": "workspace:^",
    "@atproto-labs/simple-store": "workspace:^",
    "@atproto-labs/simple-store-memory": "workspace:^",
    "@atproto/did": "workspace:^"
  },
  "devDependencies": {
    "@atproto/lex": "workspace:^",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "codegen:lex": "lex build --clear --indexFile --lib @atproto/lex-schema --lexicons ../../../lexicons --out ./src/lexicons --include com.atproto.identity.resolveHandle",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  }
}
