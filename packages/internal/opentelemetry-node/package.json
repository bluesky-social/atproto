{
  "name": "@atproto-labs/opentelemetry-node",
  "version": "0.3.1",
  "license": "MIT",
  "description": "OpenTelemetry Node.js bootstrap and XRPC-aware helpers for atproto services",
  "keywords": [
    "atproto",
    "opentelemetry",
    "otel",
    "telemetry"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/internal/opentelemetry-node"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conventions": {
      "types": "./dist/conventions.d.ts",
      "default": "./dist/conventions.js"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "default": "./dist/instrumentation.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "default": "./dist/util.js"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resource-detector-container": "^0.9.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "import-in-the-middle": "^3.5.2"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json"
  }
}
