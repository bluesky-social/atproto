{
  "name": "@atproto-labs/opentelemetry-node",
  "version": "0.5.1",
  "license": "MIT",
  "description": "OpenTelemetry Node.js bootstrap and XRPC-aware helpers for atproto services",
  "keywords": [
    "atproto",
    "opentelemetry",
    "otel",
    "telemetry"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/internal/opentelemetry-node"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conventions": {
      "types": "./dist/conventions.d.ts",
      "default": "./dist/conventions.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "default": "./dist/util.js"
    },
    "./better-sqlite3-plugin": {
      "types": "./dist/plugins/better-sqlite3-plugin.d.ts",
      "default": "./dist/plugins/better-sqlite3-plugin.js"
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.11.1 || >=25.1.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resource-detector-container": "^0.9.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "import-in-the-middle": "^3.6.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json"
  }
}
