{
  "name": "@atproto/oauth-provider-ui",
  "version": "0.10.0",
  "license": "MIT",
  "description": "Sign-in & Sign-up UI for the @atproto/oauth-provider",
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/oauth/oauth-provider-ui"
  },
  "files": [
    "./hydration-data.d.ts",
    "./dist",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./bundle-manifest.json": {
      "default": "./dist/bundle-manifest.json"
    },
    "./hydration-data": {
      "types": "./hydration-data.d.ts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/oauth-provider-api": "workspace:*"
  },
  "devDependencies": {
    "@atproto-labs/fetch": "workspace:^",
    "@atproto-labs/rolldown-plugin-bundle-manifest": "workspace:^",
    "@atproto/oauth-scopes": "workspace:^",
    "@atproto/oauth-types": "workspace:^",
    "@atproto/syntax": "workspace:^",
    "@base-ui/react": "^1.6.0",
    "@hcaptcha/react-hcaptcha": "^1.11.2",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/core": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lingui/swc-plugin": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n": "pnpm i18n:extract && pnpm i18n:compile",
    "codegen:i18n": "pnpm run i18n",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build:ui": "vite build --emptyOutDir",
    "build": "pnpm run build:ui -- ignore additional npm args",
    "dev:ui": "vite --port 5174",
    "dev:src": "vite build --watch",
    "test": "vitest run"
  }
}
