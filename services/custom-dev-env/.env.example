# Enable the bundled Sokaa AppView.
APPVIEW_ENABLED=true
DB_POSTGRES_URL=postgresql://postgres:postgres@host.docker.internal:5432/sokaa
DB_POSTGRES_SCHEMA=pds_plc

# Public origins exposed to clients. Production requires an explicit HTTPS
# media gateway origin; do not include /v1/media or a trailing slash.
# SOKAA_APPVIEW_PUBLIC_URL=https://appview.example.com
SOKAA_APPVIEW_CDN_URL=https://media.example.com
# Copy to .env next to docker-compose.yml (optional).
# Host port mapping (change if 3000/3001 are taken on the machine)
# PDS_HOST_PORT=3000
# PLC_HOST_PORT=3001

# Ports inside the container (defaults match published ports above)
# PDS_PORT=3000
# PLC_PORT=3001

# Hostname only (no scheme) — used for PDS DID (did:web) and public URL https://<hostname>
# Local Docker: leave localhost
# PDS_HOSTNAME=localhost

# Behind TLS / VPN DNS: set hostname and override public URLs if needed
# PDS_HOSTNAME=pds.dev.internal
# PDS_PUBLIC_URL=https://pds.dev.internal
# PLC_HOSTNAME=plc.dev.internal
# PLC_PUBLIC_URL=https://plc.dev.internal

# PDS talks to PLC inside the same container (default is correct for this image)
# PDS_DID_PLC_URL=http://127.0.0.1:3001
