{
  "lexicon": 1,
  "id": "app.bsky.graph.muteActor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Creates a mute relationship for the specified account. Mutes are private in Bluesky. Requires auth.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actor"],
          "properties": {
            "actor": { "type": "string", "format": "at-identifier" },
            "kinds": {
              "type": "array",
              "description": "Scope the mute to specific kinds of content from the account. Omit for a full mute.",
              "items": {
                "type": "string",
                "knownValues": ["reposts", "quoteposts"]
              }
            }
          }
        }
      }
    }
  }
}
