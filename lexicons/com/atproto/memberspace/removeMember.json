{
  "lexicon": 1,
  "id": "com.atproto.memberspace.removeMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a member from the member list of a space governed by the memberspace policy. Requires auth as the space owner.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "did"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "Reference to the space."
            },
            "did": {
              "type": "string",
              "format": "did",
              "description": "The DID of the member to remove."
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "NotSpaceOwner"
        },
        {
          "name": "PolicyMismatch",
          "description": "The space is not governed by the memberspace policy."
        }
      ]
    }
  }
}
