{
  "lexicon": 1,
  "id": "com.atproto.memberspace.putMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a member to a space, or update an existing member's access. Requires auth as the space owner, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "did", "read", "write"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "Reference to the space."
            },
            "did": {
              "type": "string",
              "format": "did",
              "description": "The DID of the member."
            },
            "read": {
              "type": "boolean",
              "description": "Whether the member has read access."
            },
            "write": {
              "type": "boolean",
              "description": "Whether the member has write access."
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "NotSpaceOwner"
        },
        {
          "name": "PolicyMismatch",
          "description": "The space does not have a memberspace policy."
        }
      ]
    }
  }
}
