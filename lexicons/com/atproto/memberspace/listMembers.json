{
  "lexicon": 1,
  "id": "com.atproto.memberspace.listMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the members of a space with a memberspace policy. Requires auth as the space owner, implemented by PDS.",
      "parameters": {
        "type": "params",
        "required": ["space"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["members"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#member"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "PolicyMismatch",
          "description": "The space does not have a memberspace policy."
        }
      ]
    },
    "member": {
      "type": "object",
      "required": ["did", "read", "write"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        }
      }
    }
  }
}
