{
  "lexicon": 1,
  "id": "com.atproto.space.defs",
  "defs": {
    "commit": {
      "type": "object",
      "description": "Commit to the current state of a space repo. Not signed; authenticated by the repo host with a MAC instead.",
      "required": ["ver", "repo", "space", "rev", "data"],
      "properties": {
        "ver": {
          "type": "integer",
          "description": "Commit format version, currently 1."
        },
        "repo": {
          "type": "string",
          "format": "did"
        },
        "space": {
          "type": "string",
          "format": "space-ref"
        },
        "rev": {
          "type": "string",
          "format": "tid"
        },
        "data": {
          "type": "bytes",
          "description": "SHA-256 digest of the repo's LtHash state."
        }
      }
    }
  }
}
