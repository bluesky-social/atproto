{
  "lexicon": 1,
  "id": "com.atproto.space.defs",
  "defs": {
    "commit": {
      "type": "object",
      "description": "A commit over the current state of a permissioned repo. Carries no signature: the repo host authenticates it to a syncer with a MAC in the Atproto-Space-Mac response header.",
      "required": ["ver", "repo", "space", "rev", "data"],
      "properties": {
        "ver": {
          "type": "integer",
          "description": "Commit format version, currently 1."
        },
        "repo": {
          "type": "string",
          "format": "did",
          "description": "The author DID of the repo."
        },
        "space": {
          "type": "string",
          "format": "space-ref",
          "description": "Reference to the space."
        },
        "rev": {
          "type": "string",
          "format": "tid",
          "description": "Commit revision (TID)."
        },
        "data": {
          "type": "bytes",
          "description": "sha256 digest of the LtHash state (32 bytes)."
        }
      }
    }
  }
}
