{
  "lexicon": 1,
  "id": "com.atproto.space.clearRecords",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete all records in the authenticated account's repo in a space. In the space owner's repo, records published from the space's configuration (such as its policy) are kept. Requires auth, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "repo"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "Reference to the space."
            },
            "repo": {
              "type": "string",
              "format": "did",
              "description": "The DID of the repo (aka, current account)."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
