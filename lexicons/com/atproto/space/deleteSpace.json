{
  "lexicon": 1,
  "id": "com.atproto.space.deleteSpace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a space, along with the owner's repo in it. Requires auth as the space owner, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "Reference to the space to delete."
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "NotSpaceOwner"
        }
      ]
    }
  }
}
