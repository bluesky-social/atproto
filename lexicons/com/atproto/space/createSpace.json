{
  "lexicon": 1,
  "id": "com.atproto.space.createSpace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a new space, with the authenticated account as its authority. Requires auth, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["spaceType", "policy"],
          "properties": {
            "spaceType": {
              "type": "string",
              "format": "nsid"
            },
            "skey": {
              "type": "string",
              "format": "record-key",
              "description": "Space key. Generated as a TID if not provided."
            },
            "policy": {
              "type": "union",
              "description": "PDSes must support all of the listed policies. Other space hosts may support only some of them, and any host may support policies beyond those listed.",
              "refs": [
                "com.atproto.personalspace.policy",
                "com.atproto.memberspace.policy",
                "com.atproto.managedspace.policy"
              ]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceAlreadyExists"
        },
        {
          "name": "UnsupportedPolicy"
        }
      ]
    }
  }
}
