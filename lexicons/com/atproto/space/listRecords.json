{
  "lexicon": 1,
  "id": "com.atproto.space.listRecords",
  "defs": {
    "main": {
      "type": "query",
      "description": "List records in a space repo, optionally filtered by collection. Requires auth as the repo's account or with a space credential; implemented by PDS.",
      "parameters": {
        "type": "params",
        "required": ["space", "repo"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref"
          },
          "repo": {
            "type": "string",
            "format": "did"
          },
          "collection": {
            "type": "string",
            "format": "nsid",
            "description": "If omitted, lists records across all collections."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 50
          },
          "cursor": {
            "type": "string"
          },
          "excludeValues": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#record"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "RepoNotFound"
        },
        {
          "name": "RepoTakendown"
        },
        {
          "name": "RepoSuspended"
        },
        {
          "name": "RepoDeactivated"
        },
        {
          "name": "InvalidCursor"
        }
      ]
    },
    "record": {
      "type": "object",
      "required": ["collection", "rkey", "cid"],
      "properties": {
        "collection": {
          "type": "string",
          "format": "nsid"
        },
        "rkey": {
          "type": "string",
          "format": "record-key"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "value": {
          "type": "unknown"
        }
      }
    }
  }
}
