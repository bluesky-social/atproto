{
  "lexicon": 1,
  "id": "com.atproto.space.policy",
  "defs": {
    "main": {
      "type": "record",
      "description": "A published copy of a space's policy. Only authoritative in the space owner's repo.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["policy"],
        "properties": {
          "policy": {
            "type": "union",
            "description": "The policy governing the space.",
            "refs": [
              "com.atproto.personalspace.policy",
              "com.atproto.memberspace.policy",
              "com.atproto.managedspace.policy"
            ]
          }
        }
      }
    }
  }
}
