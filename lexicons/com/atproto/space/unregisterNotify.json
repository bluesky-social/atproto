{
  "lexicon": 1,
  "id": "com.atproto.space.unregisterNotify",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a registration made with registerNotify. Requires a space credential, implemented by the space host.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "service"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            },
            "service": {
              "type": "string"
            }
          }
        }
      },
      "errors": [{ "name": "SpaceNotFound" }]
    }
  }
}
