{
  "lexicon": 1,
  "id": "com.atproto.space.deleteRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a record from a space repo, or ensure it doesn't exist. Requires auth, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "repo", "collection", "rkey"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            },
            "repo": {
              "type": "string",
              "format": "did"
            },
            "collection": {
              "type": "string",
              "format": "nsid"
            },
            "rkey": {
              "type": "string",
              "format": "record-key"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        }
      ]
    }
  }
}
