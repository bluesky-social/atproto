{
  "lexicon": 1,
  "id": "com.atproto.space.removeWriter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove an account from a space's writer set, as returned by listRepos. The account is added back if it writes to the space again. Requires auth as the space owner, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "did"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            },
            "repo": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "NotSpaceOwner"
        }
      ]
    }
  }
}
