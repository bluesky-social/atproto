{
  "lexicon": 1,
  "id": "com.atproto.space.getRepo",
  "defs": {
    "main": {
      "type": "query",
      "description": "Download an account's repo within a space as a STAR file. Requires auth as the repo's account or with a space credential; implemented by PDS.",
      "parameters": {
        "type": "params",
        "required": ["space", "repo"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref",
            "description": "Reference to the space."
          },
          "repo": {
            "type": "string",
            "format": "did",
            "description": "The DID of the repo."
          }
        }
      },
      "output": {
        "encoding": "application/octet-stream"
      },
      "errors": [
        {
          "name": "BadSpaceMac",
          "description": "The Atproto-Space-Want-Mac header is missing or invalid."
        },
        { "name": "SpaceNotFound" },
        { "name": "RepoNotFound" },
        { "name": "RepoTakendown" },
        { "name": "RepoSuspended" },
        { "name": "RepoDeactivated" }
      ]
    }
  }
}
