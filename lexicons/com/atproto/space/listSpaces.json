{
  "lexicon": 1,
  "id": "com.atproto.space.listSpaces",
  "defs": {
    "main": {
      "type": "query",
      "description": "List spaces that the authenticated account has written to or is the authority for. Requires auth, implemented by PDS.",
      "parameters": {
        "type": "params",
        "properties": {
          "spaceDid": {
            "type": "string",
            "format": "did",
            "description": "Filter to spaces with this DID as their authority."
          },
          "spaceType": {
            "type": "string",
            "format": "nsid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["spaces"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "spaces": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#spaceView"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidCursor"
        }
      ]
    },
    "spaceView": {
      "type": "object",
      "required": ["space"],
      "properties": {
        "space": {
          "type": "string",
          "format": "space-ref"
        },
        "repoRev": {
          "type": "string",
          "format": "tid",
          "description": "The current revision of the account's repo in the space, if it has one."
        },
        "data": {
          "type": "bytes",
          "description": "The current commit data of the account's repo in the space, if it has one."
        },
        "spaceRev": {
          "type": "string",
          "format": "tid",
          "description": "The current revision of the space. Only included if the account is the space's authority."
        }
      }
    }
  }
}
