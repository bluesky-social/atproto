{
  "lexicon": 1,
  "id": "com.atproto.space.getSpace",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a space and its policy. Requires auth as the space owner, implemented by PDS.",
      "parameters": {
        "type": "params",
        "required": ["space"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "policy"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "space-ref"
            },
            "policy": {
              "type": "union",
              "refs": [
                "com.atproto.personalspace.policy",
                "com.atproto.memberspace.policy",
                "com.atproto.managedspace.policy"
              ]
            }
          }
        }
      },
      "errors": [{ "name": "SpaceNotFound" }]
    }
  }
}
