{
  "lexicon": 1,
  "id": "com.atproto.space.notifySpaceDeleted",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Notify a syncing service that a space was deleted and its data should be dropped. Sent by the space host to registered services. Requires service auth.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "Reference to the deleted space."
            }
          }
        }
      }
    }
  }
}
