{
  "lexicon": 1,
  "id": "com.atproto.space.getSpaceCredential",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Request a credential for reading data across a space. Depending on the space's policy, a delegation token and/or client attestation may be required. Implemented by the space host.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "credentialKey"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            },
            "credentialKey": {
              "type": "string",
              "description": "P-256 did:key that the credential is bound to."
            },
            "delegationToken": {
              "type": "string",
              "description": "Obtained from getDelegationToken."
            },
            "clientAttestation": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["credential"],
          "properties": {
            "credential": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound",
          "description": "May also be returned in place of AccountNotAuthorized, to avoid revealing that the space exists."
        },
        {
          "name": "SpaceDeleted"
        },
        {
          "name": "AccountNotAuthorized"
        },
        {
          "name": "AppNotAuthorized"
        },
        {
          "name": "NotAuthorized",
          "description": "Generic refusal. May be returned in place of AccountNotAuthorized or AppNotAuthorized."
        },
        {
          "name": "InvalidDelegationToken"
        },
        {
          "name": "InvalidClientAttestation"
        }
      ]
    }
  }
}
