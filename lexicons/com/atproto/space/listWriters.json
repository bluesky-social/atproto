{
  "lexicon": 1,
  "id": "com.atproto.space.listWriters",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the repos that hold data in a space (the writer set), with the latest known state of each. Requires a space credential, implemented by the space host.",
      "parameters": {
        "type": "params",
        "required": ["space"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "cursor": {
            "type": "string",
            "description": "Return repos updated after this space revision."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repos"],
          "properties": {
            "repos": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#repo"
              },
              "description": "Ordered by spaceRev, ascending."
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "RepoTakendown",
          "description": "The space authority has been taken down."
        },
        {
          "name": "RepoDeactivated",
          "description": "The space authority has been deactivated."
        }
      ]
    },
    "repo": {
      "type": "object",
      "required": ["repo", "latest", "spaceRev"],
      "properties": {
        "repo": {
          "type": "string",
          "format": "did"
        },
        "latest": {
          "type": "union",
          "refs": [
            "com.atproto.space.defs#repoWrite",
            "com.atproto.space.defs#repoRemoved"
          ]
        },
        "spaceRev": {
          "type": "string",
          "format": "tid",
          "description": "The space revision at which this repo was last updated."
        }
      }
    }
  }
}
