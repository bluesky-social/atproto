{
  "lexicon": 1,
  "id": "com.atproto.space.notifyCredentialRevoked",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Notify a repo host that the space authority has revoked one or more credentials. Authenticated with service auth from the space authority, addressed to the repo DID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "credentials"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "Reference to the space."
            },
            "credentials": {
              "type": "array",
              "minLength": 1,
              "maxLength": 100,
              "description": "The jti of the revoked credentials.",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
