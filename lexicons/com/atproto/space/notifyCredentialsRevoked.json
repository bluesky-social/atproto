{
  "lexicon": 1,
  "id": "com.atproto.space.notifyCredentialsRevoked",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Notify a repo host that space credentials have been revoked. Sent by the space host. Requires service auth, implemented by PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "credentials"],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref"
            },
            "credentials": {
              "type": "array",
              "minLength": 1,
              "maxLength": 100,
              "description": "The IDs (jti) of the revoked credentials.",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
