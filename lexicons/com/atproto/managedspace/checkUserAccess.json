{
  "lexicon": 1,
  "id": "com.atproto.managedspace.checkUserAccess",
  "defs": {
    "main": {
      "type": "query",
      "description": "Check whether a user may read or write in a managed space. Called by the space host, implemented by the space's managing app. Requires service auth.",
      "parameters": {
        "type": "params",
        "required": ["space", "user", "access"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref"
          },
          "user": {
            "type": "string",
            "format": "did"
          },
          "access": {
            "type": "string",
            "knownValues": ["read", "write"]
          },
          "clientId": {
            "type": "string",
            "description": "OAuth client ID of the requesting app, if attested."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["authorized"],
          "properties": {
            "authorized": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
