{
  "lexicon": 1,
  "id": "tools.ozone.server.getCapabilities",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "notifications": {
              "type": "ref",
              "ref": "#notificationConfig"
            },
            "reportActionAllOwned": {
              "type": "boolean",
              "description": "Whether moderation events support account-wide reportAction targeting."
            }
          }
        }
      }
    },
    "notificationConfig": {
      "type": "object",
      "required": ["channels"],
      "properties": {
        "channels": {
          "type": "array",
          "minLength": 1,
          "items": {
            "type": "string",
            "knownValues": ["inApp", "push"]
          }
        }
      }
    }
  }
}
