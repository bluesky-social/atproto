{
  "lexicon": 1,
  "id": "tools.ozone.hosting.getAccountPreferences",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get private preferences for an account hosted by the configured PDS.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["preferences"],
          "properties": {
            "preferences": {
              "type": "ref",
              "ref": "app.bsky.actor.defs#preferences"
            }
          }
        }
      }
    }
  }
}
