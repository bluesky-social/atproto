{
  "lexicon": 1,
  "id": "tools.ozone.team.listOnlineMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "List recent active team members, ordered by latest activity.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["members"],
          "properties": {
            "members": {
              "type": "array",
              "maxLength": 100,
              "items": { "type": "ref", "ref": "#onlineMember" }
            }
          }
        }
      }
    },
    "onlineMember": {
      "type": "object",
      "required": ["did", "lastActive"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "lastActive": { "type": "string", "format": "datetime" }
      }
    }
  }
}
