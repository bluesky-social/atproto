{
  "lexicon": 1,
  "id": "app.bsky.unspecced.getAtmosphereTimeline",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the authenticated viewer's Atmosphere activity timeline. Groups contain visible activities from the returned page.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "cursor": { "type": "string" },
            "feed": {
              "type": "array",
              "items": {
                "type": "union",
                "refs": [
                  "#activityItem",
                  "#activityActorGroup",
                  "#activitySubjectGroup"
                ]
              }
            }
          }
        }
      }
    },
    "activityItem": {
      "type": "object",
      "required": ["ref", "collection", "indexedAt", "actor", "subject"],
      "properties": {
        "ref": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
        "collection": { "type": "string", "format": "nsid" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "actor": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewBasic"
        },
        "subject": { "type": "ref", "ref": "#activitySubject" },
        "relatedActivity": {
          "type": "array",
          "description": "All visible activities targeting this item's subject, such as recommendations of a newly published article.",
          "items": { "type": "ref", "ref": "#activityRef" }
        }
      }
    },
    "activityRef": {
      "type": "object",
      "description": "An activity attributed to its actor, without a hydrated subject.",
      "required": ["ref", "collection", "indexedAt", "actor"],
      "properties": {
        "ref": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
        "collection": { "type": "string", "format": "nsid" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "actor": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewBasic"
        }
      }
    },
    "activityRecord": {
      "ref": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
      "collection": { "type": "string", "format": "nsid" },
      "indexedAt": { "type": "string", "format": "datetime" },
      "record": { "type": "unknown" }
    },
    "activitySubject": {
      "type": "object",
      "description": "The subject of any activity, grouped or not.",
      "required": ["view"],
      "properties": {
        "view": {
          "type": "union",
          "refs": [
            "app.bsky.embed.external#viewArticle",
            "app.bsky.embed.external#viewArticlePublication",
            "app.bsky.embed.external#viewGallery",
            "app.bsky.embed.external#viewLivestream"
          ]
        },
        "bskyPostRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        },
        "bskyPostView": {
          "type": "ref",
          "ref": "app.bsky.feed.defs#postView"
        }
      }
    },
    "activityActorGroup": {
      "type": "object",
      "required": ["collection", "indexedAt", "actor", "items", "itemRefs"],
      "properties": {
        "collection": { "type": "string", "format": "nsid" },
        "indexedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the group's newest activity was indexed."
        },
        "actor": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewBasic"
        },
        "items": {
          "type": "array",
          "description": "Unique hydrated subjects of the group's activities, newest first. Currently only the newest subject is returned; activities without a hydrated subject are available through itemRefs (e.g. for a 'View all' list).",
          "minLength": 1,
          "items": { "type": "ref", "ref": "#activitySubject" }
        },
        "itemRefs": {
          "type": "array",
          "description": "Refs of all available group items, including the hydrated item, in newest-first timeline order.",
          "minLength": 2,
          "items": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
        }
      }
    },
    "activitySubjectGroup": {
      "type": "object",
      "required": ["collection", "indexedAt", "subject", "items", "itemRefs"],
      "properties": {
        "collection": { "type": "string", "format": "nsid" },
        "indexedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the group's newest activity was indexed."
        },
        "subject": { "type": "ref", "ref": "#activitySubject" },
        "items": {
          "type": "array",
          "description": "Activities targeting the subject, attributed to their actors, newest first. May be a subset of the group's activities; itemRefs lists all of them.",
          "minLength": 1,
          "items": { "type": "ref", "ref": "#activityRef" }
        },
        "itemRefs": {
          "type": "array",
          "description": "Refs of all available activities in the group, including those in items, in newest-first timeline order.",
          "minLength": 2,
          "items": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
        }
      }
    }
  }
}
