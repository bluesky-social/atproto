{
  "lexicon": 1,
  "id": "app.bsky.unspecced.getAtmosphereTimeline",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the authenticated viewer's Atmosphere activity timeline. Groups contain visible activities from the returned page.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "cursor": { "type": "string" },
            "feed": {
              "type": "array",
              "items": {
                "type": "union",
                "refs": [
                  "#activityItem",
                  "#activityAuthorGroup",
                  "#activitySubjectGroup"
                ]
              }
            }
          }
        }
      }
    },
    "activityRecord": {
      "type": "object",
      "required": ["uri", "cid", "indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    },
    "viewerState": {
      "type": "object",
      "required": ["subscribed"],
      "properties": {
        "subscribed": { "type": "boolean" }
      }
    },
    "activityItem": {
      "type": "object",
      "required": ["record", "collection", "viewerState"],
      "properties": {
        "record": { "type": "ref", "ref": "#activityRecord" },
        "collection": { "type": "string", "format": "nsid" },
        "viewerState": { "type": "ref", "ref": "#viewerState" },
        "bskyPostRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef",
          "description": "The Bluesky post associated with the rendered article or livestream, as declared by its author. The referenced post may not be available."
        },
        "viewBskyPost": {
          "type": "ref",
          "ref": "app.bsky.feed.defs#postView",
          "description": "The hydrated Bluesky post associated with the rendered article or livestream, as declared by its author. Omitted when the post is unavailable to the viewer."
        },
        "view": {
          "type": "union",
          "refs": [
            "app.bsky.embed.external#viewArticle",
            "app.bsky.embed.external#viewArticlePublication",
            "app.bsky.embed.external#viewGallery",
            "app.bsky.embed.external#viewLivestream",
            "app.bsky.feed.defs#postView"
          ]
        }
      }
    },
    "activityAuthorGroup": {
      "type": "object",
      "description": "Activities by one author in one collection, positioned at the newest group item. Only the newest item is hydrated.",
      "required": ["id", "collection", "indexedAt", "actor", "item", "uris"],
      "properties": {
        "id": { "type": "string" },
        "collection": { "type": "string", "format": "nsid" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "actor": { "type": "string", "format": "did" },
        "item": { "type": "ref", "ref": "#activityItem" },
        "uris": {
          "type": "array",
          "description": "All visible group item URIs, including the hydrated item, in newest-first timeline order.",
          "minLength": 2,
          "items": { "type": "string", "format": "at-uri" }
        }
      }
    },
    "activitySubject": {
      "type": "object",
      "description": "The shared target of grouped activities, not an activity itself.",
      "required": ["uri", "viewerState", "view"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "viewerState": { "type": "ref", "ref": "#viewerState" },
        "bskyPostRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef",
          "description": "The author's declared Bluesky post for the target. The post may be unavailable."
        },
        "viewBskyPost": {
          "type": "ref",
          "ref": "app.bsky.feed.defs#postView",
          "description": "The hydrated Bluesky post declared by the target's author. Omitted when the post is unavailable to the viewer."
        },
        "view": {
          "type": "union",
          "refs": [
            "app.bsky.embed.external#viewArticle",
            "app.bsky.embed.external#viewArticlePublication",
            "app.bsky.embed.external#viewGallery"
          ]
        }
      }
    },
    "activityGroupItem": {
      "type": "object",
      "description": "An unhydrated group item. Its actor DID is the authority of its record URI.",
      "required": ["record", "collection"],
      "properties": {
        "record": { "type": "ref", "ref": "#activityRecord" },
        "collection": { "type": "string", "format": "nsid" }
      }
    },
    "activitySubjectGroup": {
      "type": "object",
      "description": "Activities sharing a target, positioned at the newest group item. Article creation, recommendations, and shares group across the returned page without a time window. Publication subscriptions and gallery favorites retain age-based grouping windows.",
      "required": ["id", "indexedAt", "subject", "activities", "actors"],
      "properties": {
        "id": { "type": "string" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "subject": { "type": "ref", "ref": "#activitySubject" },
        "activities": {
          "type": "array",
          "description": "Visible group items in newest-first timeline order.",
          "minLength": 2,
          "items": { "type": "ref", "ref": "#activityGroupItem" }
        },
        "actors": {
          "type": "array",
          "description": "Unique actors in first-appearance order among group items, including the article author when creation is a group item.",
          "items": {
            "type": "ref",
            "ref": "app.bsky.actor.defs#profileViewBasic"
          }
        }
      }
    }
  }
}
