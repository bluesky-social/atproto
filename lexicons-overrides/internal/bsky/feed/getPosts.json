{
  "lexicon": 1,
  "id": "internal.bsky.feed.getPosts",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get post views for a list of posts (by AT-URI). Intended for internal service-to-service use.",
      "parameters": {
        "type": "params",
        "required": ["uris"],
        "properties": {
          "uris": {
            "type": "array",
            "description": "List of post AT-URIs to return hydrated views for.",
            "items": { "type": "string", "format": "at-uri" },
            "maxLength": 200
          },
          "includeTakedowns": {
            "type": "boolean",
            "default": false,
            "description": "Include taken-down posts in the response rather than omitting them. For service-to-service moderation use only."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["posts"],
          "properties": {
            "posts": {
              "type": "array",
              "items": { "type": "ref", "ref": "app.bsky.feed.defs#postView" }
            }
          }
        }
      }
    }
  }
}
